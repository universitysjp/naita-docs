{
  "name": "naita-diary-cli",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "naita-diary": "src/cli.mts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/app.ts",
    "cli": "bun run src/cli.mts",
    "cli:bun": "bun run src/cli.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:tui": "bun test tests/tui",
    "test:all": "bun run format:check && bun run lint && bun run test && bun run test:tui && bun run test:e2e && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests docs README.md AGENTS.md package.json tsconfig.json vitest.config.mts playwright.config.mts",
    "format:check": "oxfmt --check src tests docs README.md AGENTS.md package.json tsconfig.json vitest.config.mts playwright.config.mts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pdfjs-dist": "6.3.289",
    "typescript": "^7.0.2",
    "ultracite": "7.12.1",
    "vitest": "5.0.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2"
}
